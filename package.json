{
  "name": "cars-compound",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "bash scripts/hostinger-single-build.sh",
    "build:api": "pnpm --filter @cc/domain build && pnpm --filter @cc/config build && pnpm --filter @cc/ai build && pnpm --filter @cc/notifications build && pnpm --filter @cc/db build && pnpm --filter @cc/api build",
    "build:turbo": "turbo run build",
    "lint": "turbo run lint",
    "start": "pnpm --filter @cc/api start",
    "start:railway": "mkdir -p /data && pnpm db:push && if [ \"$ALLOW_DEMO_SEED\" = \"1\" ]; then pnpm db:seed; fi && pnpm --filter @cc/api start",
    "start:api": "pnpm --filter @cc/api start",
    "start:worker": "pnpm --filter @cc/api start:worker",
    "start:web": "pnpm --filter @cc/web start",
    "db:generate": "pnpm --filter @cc/db generate",
    "db:migrate": "pnpm --filter @cc/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @cc/db migrate:deploy",
    "db:push": "pnpm --filter @cc/db push",
    "db:seed": "pnpm --filter @cc/db seed",
    "db:studio": "pnpm --filter @cc/db studio",
    "worker": "pnpm --filter @cc/api worker",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "hostinger:shared:build-api": "bash scripts/hostinger-shared-build-api.sh",
    "hostinger:shared:build-web": "bash scripts/hostinger-shared-build-web.sh",
    "hostinger:single:build": "bash scripts/hostinger-single-build.sh",
    "hostinger:single:start": "node scripts/hostinger-single-start.cjs",
    "db:mysql:prepare": "node scripts/switch-prisma-mysql.cjs",
    "db:bootstrap:prod": "pnpm --filter @cc/db exec tsx prisma/bootstrap-prod.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
