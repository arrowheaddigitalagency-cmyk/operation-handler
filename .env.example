# Application
NODE_ENV=development
APP_NAME=Cars Compound
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Hostinger SINGLE domain (one Node app): API_URL=http://127.0.0.1:4000
# Hostinger TWO apps: API_URL=https://api.yourdomain.com
# API_INTERNAL_PORT=4000
APP_TIMEZONE=America/New_York
CURRENCY=USD
MEDIA_RETENTION_MONTHS=24
GOOGLE_REVIEW_URL=https://g.page/r/REPLACE

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Production MUST be true (HTTPS). Local HTTP can stay false.
COOKIE_SECURE=false

# Database
# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Production Hostinger MySQL — also set prisma datasource provider to "mysql":
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/cars_compound?connection_limit=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cars-compound
# Set true to store locally under ./uploads when Cloudinary unset
STORAGE_LOCAL_FALLBACK=true

# AI
# mock = free fake results (demo). gemini = your free-tier Gemini. openai = paid OpenAI.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
AI_MAX_IMAGES=8
AI_MAX_IMAGE_MB=8

# ---------------------------------------------------------------------------
# Damage Estimate module (CCC-style track) — FREE providers
# ---------------------------------------------------------------------------
# VIN decode: nhtsa = free US government API (recommended). Others are stubs.
VIN_PROVIDER=nhtsa
NHTSA_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
# Damage AI: mock = fake 2-photo demo. gemini = inspects ALL photos (needs GEMINI_API_KEY).
# onnx = apps/ml-service (needs ML_SERVICE_URL + damage.onnx).
DAMAGE_PROVIDER=gemini
# ML_SERVICE_URL=http://127.0.0.1:8000
# DAMAGE_PROVIDER=onnx
# Parts $: collision_catalog = free body-panel price bands (sample, not CCC).
PARTS_PROVIDER=collision_catalog
# Labor hours: openlabor = Open Labor Project free API. mock = local heuristics.
LABOR_PROVIDER=openlabor
OPEN_LABOR_API_KEY=
# OPEN_LABOR_BASE_URL=https://openlaborproject.com
PAINT_PROVIDER=mock
# Training dataset downloads (never commit real keys)
ROBOFLOW_API_KEY=
# Leave unset so downloads do NOT burn Roboflow credits (free tier ~10).
# USE_ROBOFLOW=1
KAGGLE_USERNAME=
KAGGLE_KEY=
DE_MAX_IMAGES=12
DE_MAX_IMAGE_MB=8

# Email
# console = print to logs only (OK for early demo). resend = real email (free tier available).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@carscompound.local

# SMS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Worker / cron
CRON_SECRET=change-me-cron-secret
# VPS + PM2: true (runs apps/api dist/worker.js).
# Hostinger Shared: false — use Hostinger Cron → HTTP endpoints instead (see docs/HOSTINGER_SHARED_DEPLOYMENT.md).
ENABLE_WORKER=true

# Monitoring (optional)
SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:3000
